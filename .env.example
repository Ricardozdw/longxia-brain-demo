# 复制为 .env 后生效；不配置也能完整运行（使用本地规则解析意图）

# 可选：接入兼容 OpenAI Chat Completions 协议的大模型做意图理解（DeepSeek / 通义 / Kimi 等）
# LLM_API_URL=https://api.deepseek.com/v1/chat/completions
# LLM_API_KEY=你的密钥
# LLM_MODEL=deepseek-chat

# 可选：服务端口，默认 4320
# PORT=4320

# 可选：视频播放窗口位置与大小（x,y,宽,高），录屏时避免挡住其他窗口；不填则最大化
# BROWSER_WINDOW=0,40,1400,880
